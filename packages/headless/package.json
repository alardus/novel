{
  "name": "@alardus/novel",
  "version": "1.0.3-alardus.1",
  "description": "Notion-style WYSIWYG editor with AI-powered autocompletions",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "dev": "tsup --watch",
    "test": "node --import tsx --test 'src/**/*.test.ts' 'src/**/*.test.tsx'",
    "typecheck": "tsc --noEmit",
    "build": "tsup",
    "lint": "biome lint ./src",
    "format": "biome format ./src "
  },
  "sideEffects": false,
  "peerDependencies": {
    "react": ">=18"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.1.1",
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-character-count": "3.31.3",
    "@tiptap/extension-code-block-lowlight": "3.31.3",
    "@tiptap/extension-color": "3.31.3",
    "@tiptap/extension-highlight": "3.31.3",
    "@tiptap/extension-horizontal-rule": "3.31.3",
    "@tiptap/extension-image": "3.31.3",
    "@tiptap/extension-link": "3.31.3",
    "@tiptap/extension-placeholder": "3.31.3",
    "@tiptap/extension-task-item": "3.31.3",
    "@tiptap/extension-task-list": "3.31.3",
    "@tiptap/extension-text-style": "3.31.3",
    "@tiptap/extension-underline": "3.31.3",
    "@tiptap/extension-youtube": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "@tiptap/suggestion": "3.31.3",
    "@types/node": "^22.10.6",
    "cmdk": "^1.0.4",
    "highlight.js": "^11.11.1",
    "jotai": "^2.11.0",
    "katex": "^0.16.20",
    "lowlight": "^3.3.0",
    "react-markdown": "^9.0.3",
    "react-moveable": "^0.56.0",
    "react-tweet": "^3.2.1",
    "tiptap-extension-global-drag-handle": "^0.1.18",
    "tiptap-markdown": "^0.9.0",
    "tunnel-rat": "^0.1.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/katex": "^0.16.7",
    "@types/react": "^18.2.55",
    "@types/react-dom": "18.2.19",
    "tsconfig": "workspace:*",
    "tsup": "^8.3.5",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  },
  "author": "Steven Tey <stevensteel97@gmail.com>",
  "homepage": "https://novel.sh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alardus/novel.git"
  },
  "bugs": {
    "url": "https://github.com/alardus/novel/issues"
  },
  "keywords": [
    "ai",
    "novel",
    "editor",
    "markdown",
    "nextjs",
    "react"
  ]
}
